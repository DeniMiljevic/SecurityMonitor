[Unit]
Description=Failed Login Security Monitor
# Start before the login screen, so the first attempt is already watched.
Before=display-manager.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/dotnet /opt/securitymonitor/SecurityMonitor.Host.Linux.dll
WorkingDirectory=/opt/securitymonitor
Restart=on-failure
RestartSec=5
# On stop, signal only our process. It stops its own journalctl child first;
# systemd kills anything left over afterwards.
KillMode=mixed

[Install]
WantedBy=multi-user.target