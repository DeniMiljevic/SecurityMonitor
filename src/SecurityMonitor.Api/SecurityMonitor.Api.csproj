<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Contracts stay free of StreamJsonRpc, so the interface cannot carry [JsonRpcContract]. -->
		<NoWarn>$(NoWarn);StreamJsonRpc0003</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
		<PackageReference Include="StreamJsonRpc" Version="2.26.150" />
	</ItemGroup>
	
	<ItemGroup>
		<ProjectReference Include="..\SecurityMonitor.Contracts\SecurityMonitor.Contracts.csproj" />
	</ItemGroup>

</Project>