<Project Sdk="Microsoft.NET.Sdk.Worker">

	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<OutputType Condition="'$(Configuration)' == 'Release'">WinExe</OutputType>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Contracts stay free of StreamJsonRpc, so the interface cannot carry [JsonRpcContract]. -->
		<NoWarn>$(NoWarn);StreamJsonRpc0003</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
		<PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
		<PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="StreamJsonRpc" Version="2.26.150" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SecurityMonitor.Contracts\SecurityMonitor.Contracts.csproj" />
	</ItemGroup>

</Project>